# Base de datos (Postgres en Supabase). Ve a tu proyecto de Supabase →
# Project Settings → Database → Connection string → pestaña "Transaction"
# (puerto 6543, modo pooler) y pega aquí esa cadena con tu contraseña real.
# Antes de usarla por primera vez, corre el contenido de supabase/schema.sql
# en el "SQL Editor" de Supabase para crear las tablas.
DATABASE_URL=

# Mercado Pago (Checkout Pro) — pagos en línea de la tienda
# 1. Crea una cuenta en https://www.mercadopago.com.mx/developers/panel
# 2. Copia tu Access Token (empieza probando con el de PRUEBA, luego cambia al de producción)
# 3. Pégalo aquí como MERCADOPAGO_ACCESS_TOKEN
# Mientras esta variable esté vacía, el botón "Pagar en línea" se oculta solo
# y la tienda sigue funcionando normalmente por WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=

# Acceso al panel administrativo (/admin). En Vercel son OBLIGATORIAS: si
# falta alguna, el panel queda cerrado. Solo en local (sin Vercel) se usan
# admin / biker2026 para que el proyecto arranque en demo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=biker2026

# Clave para firmar la cookie de sesión del admin. Genera una cadena aleatoria
# larga (por ejemplo con `openssl rand -hex 32`) y no la compartas. En Vercel
# es obligatoria; solo en local se usa una clave de desarrollo si falta.
ADMIN_SESSION_SECRET=

# Fotos de los artículos de segunda mano (Supabase Storage). En tu proyecto de
# Supabase: Project URL en Integrations → Data API, y la llave secreta en
# Settings → API Keys → Secret keys (sb_secret_…). Esa llave da acceso total:
# solo va en el servidor (Vercel), nunca en el código ni en el navegador.
# Crea antes el bucket público "segunda-mano" (ver supabase/schema.sql).
# Si las dejas vacías, en local las fotos se guardan en data/uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
