# Base de datos (Postgres en Supabase). Ve a tu proyecto de Supabase →
# Project Settings → Database → Connection string → pestaña "Transaction"
# (puerto 6543, modo pooler) y pega aquí esa cadena con tu contraseña real.
# Antes de usarla por primera vez, corre el contenido de supabase/schema.sql
# en el "SQL Editor" de Supabase para crear las tablas.
DATABASE_URL=

# Mercado Pago (Checkout Pro) — pagos en línea de la tienda
# 1. Crea una cuenta en https://www.mercadopago.com.mx/developers/panel
# 2. Copia tu Access Token (empieza probando con el de PRUEBA, luego cambia al de producción)
# 3. Pégalo aquí como MERCADOPAGO_ACCESS_TOKEN
# Mientras esta variable esté vacía, el botón "Pagar en línea" se oculta solo
# y la tienda sigue funcionando normalmente por WhatsApp.
MERCADOPAGO_ACCESS_TOKEN=

# Acceso al panel administrativo (/admin). Si no defines estas dos variables,
# se usan admin / biker2026 solo para que el proyecto arranque en demo —
# cámbialas antes de usar esto con clientes reales.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=biker2026

# Clave para firmar la cookie de sesión del admin. Genera una cadena aleatoria
# larga (por ejemplo con `openssl rand -hex 32`) y no la compartas. Si la
# dejas vacía se usa una clave de desarrollo insegura — no lo hagas en producción.
ADMIN_SESSION_SECRET=
